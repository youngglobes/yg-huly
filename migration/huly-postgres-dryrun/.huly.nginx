server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    # front (Express) already sets correct Cache-Control + gzip for hashed bundles and index.html.
    # serviceWorker.js is the one exception: it has no content hash in its filename, but Express's
    # static middleware still applies a blanket 1y max-age to it - override that here so browsers
    # revalidate it on every load instead of getting stuck on a stale service worker indefinitely.
    location = /serviceWorker.js {
        add_header Cache-Control "no-cache";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://front:8080;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://front:8080;
    }

    location /_accounts {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        rewrite ^/_accounts(/.*)$ $1 break;
        proxy_pass http://account:3000/;
    }

